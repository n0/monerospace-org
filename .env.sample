# xmr-space environment variables
# Copy to `.env` and adjust. The upstream `mempool-config.sample.json` still
# governs Bitcoin-side config; this file only covers Monero overrides.

# Monerod JSON-RPC endpoint. Production compose defaults to the bundled
# private monerod container. Local dev can keep using Cake Wallet's public node.
MONEROD_RPC_URL=https://xmr-node.cakewallet.com:18081

# Optional fallback daemons, comma-separated. In production this is Cake Wallet
# so monerospace stays live while the local node is bootstrapping or unhealthy.
# MONEROD_RPC_FALLBACK_URLS=https://xmr-node.cakewallet.com:18081

# When fallback daemons are configured, keep using fallback until the primary
# reports synced/current. Disable only if you intentionally want stale local data.
# MONEROD_RPC_REQUIRE_SYNC=true
# MONEROD_RPC_MAX_HEIGHT_LAG=10
# MONEROD_RPC_HEALTH_INTERVAL_MS=15000

# Optional digest-auth credentials when targeting a node started with `--rpc-login`.
# Public nodes don't need these.
# MONEROD_RPC_USER=
# MONEROD_RPC_PASSWORD=

# Per-request timeout in ms.
MONEROD_RPC_TIMEOUT_MS=10000
